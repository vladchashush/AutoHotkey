; Play/Pause на Ctrl+Alt+P
^!0::Send {Media_Play_Pause}

; Следующий трек на Ctrl+Alt+Right
^!Right::Send {Media_Next}

; Предыдущий трек на Ctrl+Alt+Left
^!Left::Send {Media_Prev}

; Громкость вверх на Ctrl+Alt+Up
^!Up::Send {Volume_Up}

; Громкость вниз на Ctrl+Alt+Down
^!Down::Send {Volume_Down}

; Выключить звук на Ctrl+Alt+M
^!m::Send {Volume_Mute}
